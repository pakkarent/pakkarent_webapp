{
  "cleanUrls": true,
  "renderSingle": true,
  "rewrites": [
    { "source": "/rent/**", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/products/**", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/**", "destination": "/index.html" },
    { "source": "/festive/**", "destination": "/index.html" },
    { "source": "/chennai", "destination": "/index.html" },
    { "source": "/bangalore", "destination": "/index.html" },
    { "source": "/hyderabad", "destination": "/index.html" },
    { "source": "/store/**", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/my-orders", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/how-it-works", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/delivery-info", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/**", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(png|svg|ico|webp|jpg|jpeg|gif|woff2|woff|txt|xml))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/products/event/golden_oonjal.html", "destination": "/rent/chennai/golden-jhula-swing", "type": 301 },
    { "source": "/products/event/oonjal.html", "destination": "/rent/chennai/teak-jhula-swing", "type": 301 },
    { "source": "/products/event/Rolu_Rokali.html", "destination": "/rent/chennai/silver-rolu-rokali", "type": 301 },
    { "source": "/products/event/Royal_golden_sofa.html", "destination": "/rent/chennai/royal-golden-sofa", "type": 301 },
    { "source": "/products/event/Chair_rent.html", "destination": "/rent/chennai/armless-chairs", "type": 301 },
    { "source": "/products/event/Red_Carpet_Rental.html", "destination": "/rent/chennai/red-carpet", "type": 301 },
    { "source": "/products/event/balloondecor.html", "destination": "/rent/chennai/led-lights", "type": 301 },
    { "source": "/products/event/Wooden_Cake_Stand_Combo.html", "destination": "/rent/chennai/wooden-cake-stands", "type": 301 },
    { "source": "/products/backdrop/BananaLeaf_Backdrop.html", "destination": "/rent/chennai/banana-leaf-backdrop", "type": 301 },
    { "source": "/products/backdrop/Dreamy_Ring_Backdrop.html", "destination": "/rent/chennai/dreamy-ring-birthday-backdrop", "type": 301 },
    { "source": "/products/backdrop/Flowerwall_Backdrop.html", "destination": "/rent/chennai/flower-wall-backdrop", "type": 301 },
    { "source": "/products/backdrop/Pink_Rani_Backdrop.html", "destination": "/rent/chennai/pink-rani-backdrop", "type": 301 },
    { "source": "/products/baby/Kids_Car_Rental.html", "destination": "/rent/chennai/baby-car-for-birthday", "type": 301 },
    { "source": "/products/baby/Baby_Jeep_Rent.html", "destination": "/rent/chennai/baby-jeep-rental", "type": 301 },
    { "source": "/Hyderabad/products/backdrop/Elegant_Greenish_backdrop_rental.html", "destination": "/rent/hyderabad/elegant-greenish-backdrop", "type": 301 }
  ]
}
